      "discriminant": "callout",
      "value": {
        "tone": "info",
        "title": "How you get in",
        "body": "Five-year programmes: CLAT (most National Law Universities), AILET (NLU Delhi), state law CETs, and university tests. Three-year LLB: state law CETs or university merit after graduation."
      }
    },
    {
      "discriminant": "list",
      "value": {
        "title": "At a glance",
        "items": [
          "To practise you enrol with a State Bar Council and pass the All India Bar Examination (AIBE).",
          "Litigation, corporate law and the judiciary are quite different paths with different routines.",
          "An LLM (one year, via CLAT PG and other tests) is the usual next degree."
        ]
      }
