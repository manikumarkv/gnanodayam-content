    {
      "discriminant": "text",
      "value": {
        "body": "An arts degree in a subject such as Economics, Political Science, History, Psychology, English or Sociology. It is usually three years, with a four-year Honours option under the NEP. It builds reading, writing and analysis, and is the most widely studied undergraduate degree in India."
      }
    },
